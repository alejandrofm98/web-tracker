datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model NotificationSettings {
  id             Int      @id @default(1)
  enabled        Boolean  @default(true)
  sendTime       String   @default("09:00")
  domainEnabled  Boolean  @default(true)
  chargeEnabled  Boolean  @default(true)
  domainDays     Int[]    @default([30, 15, 7, 1])
  chargeDays     Int[]    @default([30, 15, 7, 1])
  updatedAt      DateTime @updatedAt
}

model Website {
  id               String    @id @default(cuid())
  name             String
  url              String
  clientName       String    @default("")
  clientContact    String    @default("")
  status           String    @default("activa")
  domainProvider   String    @default("")
  domainExpiresAt  DateTime?
  domainCost       Float?
  domainAutoRenew  Boolean   @default(false)
  hostingProvider  String    @default("")
  hostingPlan      String    @default("")
  ownCost          Float?
  clientPrice      Float?
  billingPeriod    String    @default("anual")
  nextChargeAt     DateTime?
  chargeStatus     String    @default("pendiente")
  stack            String    @default("")
  repoUrl          String    @default("")
  credentialsHint  String    @default("")
  envHint          String    @default("")
  notes            String    @default("")
  lastNotifiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
